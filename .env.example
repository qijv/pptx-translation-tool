# Optional analytics. Leave all values empty to disable requests and visitor IDs.
# Copy to .env.local only if you operate your own analytics service.
# VITE_* values are PUBLIC in the browser bundle; never put API secrets here.
VITE_ANALYTICS_SITE=
VITE_ANALYTICS_KEY=
VITE_ANALYTICS_COLLECT_URL=
VITE_ANALYTICS_SUMMARY_URL=
